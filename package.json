{
  "name": "alliance-sourcing-bd",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --require tsx/cjs --test scripts/*.test.cjs",
    "test:logo": "node --require tsx/cjs --test scripts/logo-upload.test.cjs",
    "test:banner": "node --require tsx/cjs --test scripts/banner-api.test.cjs scripts/banner-render.test.cjs",
    "test:machinery": "node --require tsx/cjs --test scripts/machinery-schema.test.cjs scripts/machinery-route.test.cjs",
    "test:faq": "node --require tsx/cjs --test scripts/faq-schema.test.cjs scripts/faq-route.test.cjs scripts/faq-render.test.cjs",
    "init:sourcing": "node --conditions=react-server --import tsx scripts/init-sourcing.ts",
    "init:machinery": "node --conditions=react-server --import tsx scripts/init-machinery.ts",
    "init:products": "node --conditions=react-server --import tsx scripts/init-products.ts",
    "init:faqs": "node --conditions=react-server --import tsx scripts/init-faqs.ts",
    "migrate:product-images": "node --conditions=react-server --import tsx scripts/migrate-product-images.ts",
    "verify:product-images": "node --conditions=react-server --import tsx scripts/verify-product-images.ts"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "better-auth": "^1.7.6",
    "cloudinary": "^2.11.0",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.10.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "^16.3.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
